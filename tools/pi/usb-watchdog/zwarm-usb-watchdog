#!/bin/sh
# Reload the USB network gadget when the receive path stalls.
#
# Stall signature: usb0 reports carrier, the Mac (.2 on the usb0 subnet) does not
# answer ping, and rx_packets does not move during the probe. A Mac with no static
# address still sends some traffic, so a frozen counter is the deciding signal.
# Reloads are rate-limited because a sleeping Mac looks the same as a stall.
set -eu

iface=usb0
min_gap=${ZWARM_USB_WATCHDOG_MIN_GAP:-180}
stamp=/run/zwarm-usb-watchdog.last

[ -d /sys/class/net/$iface ] || exit 0
[ "$(cat /sys/class/net/$iface/carrier 2>/dev/null || echo 0)" = 1 ] || exit 0

addr=$(ip -4 -o addr show dev $iface | awk '{print $4}' | cut -d/ -f1 | head -n1)
[ -n "$addr" ] || exit 0
mac_host=${addr%.*}.2

if [ "${ZWARM_USB_WATCHDOG_TEST_STALL:-0}" != 1 ]; then
    rx_before=$(cat /sys/class/net/$iface/statistics/rx_packets)
    if ping -q -c 3 -W 2 -I $iface "$mac_host" >/dev/null 2>&1; then
        exit 0
    fi
    rx_after=$(cat /sys/class/net/$iface/statistics/rx_packets)
    if [ "$rx_after" -ne "$rx_before" ]; then
        echo "No ping reply from $mac_host, but $iface is receiving; no reload"
        exit 0
    fi
fi

now=$(date +%s)
last=$(cat $stamp 2>/dev/null || echo 0)
if [ $((now - last)) -lt "$min_gap" ]; then
    echo "USB receive path stalled; last reload $((now - last))s ago, waiting"
    exit 0
fi

echo "USB receive path stalled (no reply from $mac_host, rx frozen); reloading g_ether"
echo "$now" > $stamp
modprobe -r g_ether
sleep 2
modprobe g_ether
